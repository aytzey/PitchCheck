# OpenRouter (for LLM persuasion interpretation)
SCORE_API_KEY=change-me-to-a-long-random-secret
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_REFINER_MODEL=google/gemini-3.8-flash
OPENROUTER_TIMEOUT_SECONDS=60
# Optional reasoning effort for reasoning-capable models (DeepSeek V4: high|xhigh)
OPENROUTER_REASONING_EFFORT=
PITCHCHECK_SEMANTIC_BLEND_WEIGHT=0.55
PITCHCHECK_PERSONALIZATION_FACET_WEIGHT=1.0
PITCHCHECK_CREDIBILITY_FACET_WEIGHT=0.5
# WS06 unvalidated persona-read literature priors; 0 + service restart restores pre-prior scoring/selection.
PITCHCHECK_PERSONA_READ_PRIORS=1
PITCHCHECK_SKEPTIC_FACET_BOOST=0.4
PITCHCHECK_TAILORING_PRIOR_POINTS=3
# K5 final-score prior budget (points); 0 keeps all final-score priors in shadow only.
PITCHCHECK_LITERATURE_PRIOR_BUDGET=6
# WS05 unvalidated literature prior: v2 by default; v1 + service restart restores the old rubric/writers.
# PITCHCHECK_CONTEXT_FIT_RUBRIC=v2
# WS04 doctrine_v2: no runtime/rollback env switch (the doctrine is one shared file).
# Rollback: git revert <WS04-commit>, rebuild with tribe_service/Dockerfile.server,
# and redeploy; rebuild/release desktop too for its include_str! fallback. See README.
# 0 = score ROI term and its synthesis items off; roi_summary still reported.
PITCHCHECK_ROI_PRIOR_WEIGHT=0.15
# Jev selection only (legacy reports a shadow); 0 disables the refine ROI term.
PITCHCHECK_ROI_PRIOR_POINTS=0.5
# 0 disables the provisional Falk JoCN synthesis hypothesis.
PITCHCHECK_ROI_HYPOTHESES=1
# Hermes and other feature encoders retain half weight; 0 disables the mismatched-encoder prior.
PITCHCHECK_ROI_ENCODER_MISMATCH_FACTOR=0.5
# Specificity literature prior: 0 disables all twin calls; weight=0 keeps a score shadow.
PITCHCHECK_SPECIFICITY_CONTRAST=1
PITCHCHECK_SPECIFICITY_SCORE_WEIGHT=1.5
PITCHCHECK_SPECIFICITY_Z_MIN=1.0
# 0 skips refine twin calls and the detail-retention penalty (maximum 2 selection points).
PITCHCHECK_SPECIFICITY_REFINE_PENALTY=2.0
# WS08 references can shrink ROI terms; 0 ignores their multipliers.
PITCHCHECK_ROI_INSILICO_TUNING=1
# WS03 localization context; 0 disables neighbouring segments.
PITCHCHECK_LOCALIZATION_CONTEXT_SEGMENTS=1
# WS08: unset uses the encoder's paraphrase noise floor, then a 1-point default prior.
# Set 0 to restore legacy refine ranking.
# PITCHCHECK_NEURAL_TIE_DELTA=0
# Offline measured-fMRI scaling: on|shadow|off; absent asset is a no-op.
PITCHCHECK_ROI_FIDELITY_SCALING=on
# Opt-in numbers-only score log (both required; key >= 32 chars, keep it out of git)
# PITCHCHECK_SCORE_LOG_PATH=/score-log/scores.jsonl
# PITCHCHECK_SCORE_LOG_KEY=

# TRIBE model
TRIBE_MODEL_ID=facebook/tribev2
TRIBE_DEVICE=cuda
TRIBE_TEXT_DEVICE=auto
TRIBE_TEXT_BATCH_SIZE=auto
TRIBE_TEXT_INPUT_MODE=direct
TRIBE_CACHE_DIR=/models
TRIBE_ALLOW_MOCK=0
TRIBE_PREDICTION_CACHE_SIZE=8
TRIBE_SCORE_TIMEOUT_SECONDS=900
TRIBE_MAX_SCORE_CONCURRENCY=1
TRIBE_OOM_FALLBACK_TEXT_DEVICE=accelerate,cpu
TRIBE_ACCELERATE_MAX_GPU_MEMORY_GB=auto
TRIBE_ACCELERATE_MAX_CPU_MEMORY_GB=32
TRIBE_ACCELERATE_OFFLOAD_FOLDER=/models/offload
TRIBE_SERVICE_URL=http://tribe-service:8090

# Desktop runtime defaults
PITCHCHECK_TRIBE_IMAGE=ghcr.io/aytzey/pitchcheck-tribe:latest
