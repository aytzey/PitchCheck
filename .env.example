# OpenRouter (for LLM persuasion interpretation)
SCORE_API_KEY=change-me-to-a-long-random-secret
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_REFINER_MODEL=google/gemini-3.8-flash
OPENROUTER_TIMEOUT_SECONDS=60
# Optional reasoning effort for reasoning-capable models (DeepSeek V4: high|xhigh)
OPENROUTER_REASONING_EFFORT=
PITCHCHECK_SEMANTIC_BLEND_WEIGHT=0.55
PITCHCHECK_PERSONALIZATION_FACET_WEIGHT=1.0
PITCHCHECK_CREDIBILITY_FACET_WEIGHT=0.5
# WS04 doctrine_v2: no runtime/rollback env switch (the doctrine is one shared file).
# Rollback: git revert <WS04-commit>, rebuild with tribe_service/Dockerfile.server,
# and redeploy; rebuild/release desktop too for its include_str! fallback. See README.
# Opt-in numbers-only score log (both required; key >= 32 chars, keep it out of git)
# PITCHCHECK_SCORE_LOG_PATH=/score-log/scores.jsonl
# PITCHCHECK_SCORE_LOG_KEY=

# TRIBE model
TRIBE_MODEL_ID=facebook/tribev2
TRIBE_DEVICE=cuda
TRIBE_TEXT_DEVICE=auto
TRIBE_TEXT_BATCH_SIZE=auto
TRIBE_TEXT_INPUT_MODE=direct
TRIBE_CACHE_DIR=/models
TRIBE_ALLOW_MOCK=0
TRIBE_PREDICTION_CACHE_SIZE=8
TRIBE_SCORE_TIMEOUT_SECONDS=900
TRIBE_MAX_SCORE_CONCURRENCY=1
TRIBE_OOM_FALLBACK_TEXT_DEVICE=accelerate,cpu
TRIBE_ACCELERATE_MAX_GPU_MEMORY_GB=auto
TRIBE_ACCELERATE_MAX_CPU_MEMORY_GB=32
TRIBE_ACCELERATE_OFFLOAD_FOLDER=/models/offload
TRIBE_SERVICE_URL=http://tribe-service:8090

# Desktop runtime defaults
PITCHCHECK_TRIBE_IMAGE=ghcr.io/aytzey/pitchcheck-tribe:latest
